{% assign is_zh = page.lang == 'zh' %}
{% assign scholar = site.data.scholar | default: {} %}
{% assign profile = scholar.profile | default: {} %}
{% assign top_publications = scholar.top_publications | default: empty %}

{% if is_zh %}
  {% assign achievements_title = '学术成果' %}
  {% assign achievements_desc = '手动触发同步的 Google Scholar 快照' %}
  {% assign stats_labels = '论文数|总引用|h-index|i10-index' | split: '|' %}
  {% assign publications_title = 'Top 5 引用论文' %}
  {% assign publications_desc = '按 Google Scholar 引用量排序，更新时间见卡片上方。' %}
  {% assign updated_prefix = '最近更新：' %}
  {% assign external_label = '论文链接' %}
  {% assign scholar_label = 'Scholar' %}
  {% assign empty_state = '尚未生成 Scholar 数据，先运行手动更新工作流即可。' %}
{% else %}
  {% assign achievements_title = 'Academic Achievements' %}
  {% assign achievements_desc = 'Google Scholar snapshot refreshed via manual workflow' %}
  {% assign stats_labels = 'Papers|Citations|h-index|i10-index' | split: '|' %}
  {% assign publications_title = 'Top 5 Cited Publications' %}
  {% assign publications_desc = 'Ranked by Google Scholar citations and refreshed by manual update.' %}
  {% assign updated_prefix = 'Last updated: ' %}
  {% assign external_label = 'Article' %}
  {% assign scholar_label = 'Scholar' %}
  {% assign empty_state = 'Scholar data has not been generated yet. Run the manual update workflow first.' %}
{% endif %}

<section class="about-section about-section--scholar">
  <div class="about-section__header">
    <div>
      <h2>{{ achievements_title }}</h2>
      <p>{{ achievements_desc }}</p>
    </div>
    {% if profile.updated_at %}
      <span class="about-section__meta">
        {{- updated_prefix -}}
        {{- profile.updated_at | date: '%Y-%m-%d' -}}
      </span>
    {% endif %}
  </div>

  <div class="scholar-stats">
    <article class="scholar-stat-card">
      <span class="scholar-stat-card__label">{{ stats_labels[0] }}</span>
      <strong class="scholar-stat-card__value">{{ profile.papers | default: 'N/A' }}</strong>
    </article>
    <article class="scholar-stat-card">
      <span class="scholar-stat-card__label">{{ stats_labels[1] }}</span>
      <strong class="scholar-stat-card__value">{{ profile.citations | default: 'N/A' }}</strong>
    </article>
    <article class="scholar-stat-card">
      <span class="scholar-stat-card__label">{{ stats_labels[2] }}</span>
      <strong class="scholar-stat-card__value">{{ profile.h_index | default: 'N/A' }}</strong>
    </article>
    <article class="scholar-stat-card">
      <span class="scholar-stat-card__label">{{ stats_labels[3] }}</span>
      <strong class="scholar-stat-card__value">{{ profile.i10_index | default: 'N/A' }}</strong>
    </article>
  </div>

  <div class="about-section__header about-section__header--secondary">
    <div>
      <h3>{{ publications_title }}</h3>
      <p>{{ publications_desc }}</p>
    </div>
    <a class="about-link" href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}&hl=en"> Google Scholar </a>
  </div>

  {% if top_publications.size > 0 %}
    <div class="scholar-publications">
      {% for paper in top_publications %}
        <article class="scholar-paper-card">
          <div class="scholar-paper-card__media">
            {% if paper.preview_image %}
              <img
                src="{% if paper.preview_image contains '://' %}{{ paper.preview_image }}{% else %}{{ paper.preview_image | relative_url }}{% endif %}"
                alt="{{ paper.title }}"
                loading="lazy"
              >
            {% else %}
              <div class="scholar-paper-card__placeholder" aria-hidden="true">
                <span>{{ paper.title | slice: 0 }}</span>
              </div>
            {% endif %}
          </div>

          <div class="scholar-paper-card__content">
            <div class="scholar-paper-card__meta">
              <span>{{ paper.venue | default: 'Google Scholar' }}</span>
              {% if paper.year %}
                <span>{{ paper.year }}</span>
              {% endif %}
              {% if paper.citation_count %}
                <span>
                  {%- if is_zh %}引用 {{ paper.citation_count }}{% else %}{{ paper.citation_count }} citations{% endif -%}
                </span>
              {% endif %}
            </div>

            <h4>{{ paper.title }}</h4>
            <p class="scholar-paper-card__authors">{{ paper.authors }}</p>

            <div class="scholar-paper-card__links">
              {% if paper.external_url %}
                <a class="about-button about-button--secondary" href="{{ paper.external_url }}">{{ external_label }}</a>
              {% endif %}
              {% if paper.scholar_url %}
                <a class="about-button about-button--secondary" href="{{ paper.scholar_url }}">{{ scholar_label }}</a>
              {% endif %}
              {% if paper.pdf_url %}
                <a class="about-button about-button--secondary" href="{{ paper.pdf_url }}">PDF</a>
              {% endif %}
              {% if paper.doi %}
                {% if paper.doi contains '://' %}
                  <a class="about-button about-button--secondary" href="{{ paper.doi }}">DOI</a>
                {% else %}
                  <a class="about-button about-button--secondary" href="https://doi.org/{{ paper.doi }}">DOI</a>
                {% endif %}
              {% endif %}
              {% if paper.arxiv %}
                {% if paper.arxiv contains '://' %}
                  <a class="about-button about-button--secondary" href="{{ paper.arxiv }}">arXiv</a>
                {% else %}
                  <a class="about-button about-button--secondary" href="https://arxiv.org/abs/{{ paper.arxiv }}">arXiv</a>
                {% endif %}
              {% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p class="about-empty-state">{{ empty_state }}</p>
  {% endif %}
</section>
